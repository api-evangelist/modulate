      },
      "item": [
        {
          "id": "d700dc84-737b-428c-86af-81a5c1080ac0",
          "name": "Transcribe and redact PII/PHI from an audio file",
          "request": {
            "name": "Transcribe and redact PII/PHI from an audio file",
            "description": {
              "content": "Transcribe an audio file, detect PII/PHI in the transcript, redact the text, and\nsilence the corresponding audio ranges. Returns a multipart response containing\nredacted metadata (JSON) and redacted audio (MP3).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "velma-2-pii-phi-redaction-batch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "multipart/form-data"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "upload_file",
                  "type": "file",
                  "description": "(Required) Audio file to transcribe and redact. Supported formats: AAC, AIFF, FLAC, MP3, MP4, MOV, OGG, Opus, WAV, WebM.\nMaximum file size: 100MB.\nEmpty files are rejected.\n"
                },
                {
                  "key": "speaker_diarization",
                  "value": "true",
                  "type": "text",
                  "description": "Speaker diarization identifies different speakers in the audio.\nWhen enabled, each utterance includes a speaker identifier (e.g., 1, 2).\n"
                },
                {
                  "key": "start_redaction_padding_ms",
                  "value": "100",
                  "type": "text",
                  "description": "Additional silence in milliseconds to prepend before each redacted\naudio range. Extends the silenced region earlier in time to provide\na buffer before PII/PHI content.\n"
                },
                {
                  "key": "end_redaction_padding_ms",
                  "value": "0",
                  "type": "text",
                  "description": "Additional silence in milliseconds to append after each redacted\naudio range. Extends the silenced region later in time to provide\na buffer after PII/PHI content.\n"
                },
                {
                  "key": "language",
                  "value": "<string>",
                  "type": "text",
                  "description": "Optional language hint as a case-insensitive ISO 639-1 code\n(e.g. \"en\", \"fr\"). BCP 47 region/script subtags (e.g. \"en-US\")\nare accepted; only the primary language subtag is used. When\nomitted, the language is detected automatically for each utterance.\n"
                }
              ]
            }
          },
          "response": [
