                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "upload_file",
                  "type": "file",
                  "description": "(Required) Audio file to analyse. Must be non-empty. Supported formats:\n`.3gp`, `.3gpp`, `.aac`, `.aiff`, `.amr`, `.au`, `.flac`,\n`.m4a`, `.mov`, `.mp3`, `.mp4`, `.ogg`, `.opus`, `.wav`,\n`.webm`, `.wma`. Maximum file size: 100 MB.\n"
                }
              ]
            }
