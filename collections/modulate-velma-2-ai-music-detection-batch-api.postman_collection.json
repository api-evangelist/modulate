          "name": "Detect AI-generated music in an audio file",
          "request": {
            "name": "Detect AI-generated music in an audio file",
            "description": {
              "content": "Accepts an audio file and returns a clip-level verdict on whether the\ncontent contains AI-generated music, along with a per-window breakdown\nof how each segment was classified.\n",
              "type": "text/plain"
            },
