{
  "opencollection": "1.0.0",
  "info": {
    "name": "Velma 2 Accent Batch Velma 2 Batch API",
    "version": "0.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Velma 2 Batch",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Run velma-2 batch analysis on an uploaded audio file.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.modulate.ai/api/velma-2-batch",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "upload_file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "config",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Run velma-2 batch analysis on an uploaded audio file."
        },
        {
          "info": {
            "name": "List available behavior presets.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.modulate.ai/api/velma-2-batch/list-presets"
          },
          "docs": "Returns the catalog of behavior presets that can be referenced\nfrom the `behaviors` array in a BatchConfig using the\n`preset:<identifier>` syntax. Each entry includes the preset\n`identifier`, `name`, `short_description`, and\n`detailed_description`.\n"
        }
      ]
    }
  ],
  "bundled": true
}