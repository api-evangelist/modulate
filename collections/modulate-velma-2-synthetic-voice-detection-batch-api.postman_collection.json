          "name": "Detect synthetic voice in an audio file",
          "request": {
            "name": "Detect synthetic voice in an audio file",
            "description": {
              "content": "Accepts a single audio file and returns a per-frame synthetic-voice\nclassification across the clip as a synchronous JSON response.\nRecommended audio length: 4-60 seconds; files shorter than 0.5 seconds\nare rejected with a 422.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "velma-2-synthetic-voice-detection-batch"
